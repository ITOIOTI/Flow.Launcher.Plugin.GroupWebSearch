<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 插件基础信息 -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_name">打开网页</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_description">从 Flow Launcher 打开网页与自定义搜索分组</system:String>

    <!-- 设置主面板 -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_groups">网页分组</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engines">网页目录</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete">删除</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_edit">编辑</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_add">添加</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset">重置</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_prefix">关键词：{0}</system:String>

    <!-- 网页分组设置窗口 -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_setting_title">网页分组设置</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_name">分组名称</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords">关键词</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_placeholder">* 全局触发，关键词之间添加空格</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all">打开全部网页</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable_group">启用此分组</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_cancel">取消</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_save">保存</system:String>

    <!-- 网页目录设置窗口 -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engine_setting_title">网页目录设置</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_title">标题</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_url">打开链接</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_icon">图标</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_select_icon">选择图标</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_mode">隐身模式</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable">启用</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm">确认</system:String>

    <!-- 提示与对话框 -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_group_confirm">确定要删除网页分组【{0}】及其包含的所有内容吗？</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_engine_confirm">确定要删除【{0}】吗？</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset_confirm">确定要重置所有网页分组和网页目录为默认初始配置吗？此操作无法撤销。</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_pls_select_group">请先选择或新建一个网页分组！</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_group_name">请输入分组名称</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_title">请输入标题</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_url">请输入打开链接</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_title">确认</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_delete_title">确认删除</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_reset_title">确认重置</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_tip_title">提示</system:String>

    <!-- 搜索结果 -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_title">打开全部网页：{0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_subtitle">同时在浏览器打开: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_search_in_title">在 {0} 中搜索：{1}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_title">【{0}】请输入搜索关键词...</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_subtitle">组内包含网页: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_prefix">[隐身模式] </system:String>

</ResourceDictionary>
