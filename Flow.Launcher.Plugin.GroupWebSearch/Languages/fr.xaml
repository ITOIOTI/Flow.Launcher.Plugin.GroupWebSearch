<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Plugin basic info -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_name">Ouvrir les pages Web</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_description">Ouvrir des pages Web et des groupes de recherche personnalisés depuis Flow Launcher</system:String>

    <!-- Main settings panel -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_groups">Groupes Web</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engines">Catalogues Web</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete">Supprimer</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_edit">Modifier</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_add">Ajouter</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset">Réinitialiser</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_prefix">Mots-clés : {0}</system:String>

    <!-- Web group settings window -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_setting_title">Paramètres du groupe Web</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_name">Nom du groupe</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords">Mots-clés</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_placeholder">* Déclencheur global, séparer par des espaces</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all">Ouvrir toutes les pages Web</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable_group">Activer ce groupe</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_cancel">Annuler</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_save">Enregistrer</system:String>

    <!-- Web catalog settings window -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engine_setting_title">Paramètres du catalogue Web</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_title">Titre</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_url">URL</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_icon">Icône</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_select_icon">Choisir une icône</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_mode">Mode navigation privée</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable">Activer</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm">Confirmer</system:String>

    <!-- Dialogs & Prompts -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_group_confirm">Voulez-vous vraiment supprimer le groupe Web [{0}] et tout son contenu ?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_engine_confirm">Voulez-vous vraiment supprimer [{0}] ?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset_confirm">Voulez-vous vraiment réinitialiser toutes les configurations par défaut ?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_pls_select_group">Veuillez d'abord sélectionner ou créer un groupe Web !</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_group_name">Veuillez saisir un nom de groupe</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_title">Veuillez saisir un titre</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_url">Veuillez saisir une URL</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_title">Confirmer</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_delete_title">Confirmer la suppression</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_reset_title">Confirmer la réinitialisation</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_tip_title">Information</system:String>

    <!-- Search results -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_title">Ouvrir toutes les pages Web : {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_subtitle">Ouvrir simultanément dans le navigateur : {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_search_in_title">Rechercher dans {0} : {1}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_title">[{0}] Veuillez saisir des mots-clés de recherche...</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_subtitle">Pages Web dans le groupe : {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_prefix">[Navigation privée] </system:String>

</ResourceDictionary>
