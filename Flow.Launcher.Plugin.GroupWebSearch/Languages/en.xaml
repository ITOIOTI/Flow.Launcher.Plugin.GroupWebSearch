<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Plugin basic info -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_name">Open Webpages</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_description">Open webpages and custom search groups from Flow Launcher</system:String>

    <!-- Main settings panel -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_groups">Web Groups</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engines">Web Catalogs</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete">Delete</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_edit">Edit</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_add">Add</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset">Reset</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_prefix">Keywords: {0}</system:String>

    <!-- Web group settings window -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_setting_title">Web Group Settings</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_name">Group Name</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords">Keywords</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_placeholder">* Global trigger, separate keywords with spaces</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all">Open all webpages</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable_group">Enable this group</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_cancel">Cancel</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_save">Save</system:String>

    <!-- Web catalog settings window -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engine_setting_title">Web Catalog Settings</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_title">Title</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_url">URL</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_icon">Icon</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_select_icon">Select Icon</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_mode">Private Mode</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable">Enable</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm">Confirm</system:String>

    <!-- Dialogs & Prompts -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_group_confirm">Are you sure you want to delete web group [{0}] and all its contents?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_engine_confirm">Are you sure you want to delete [{0}]?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset_confirm">Are you sure you want to reset all web groups and web catalogs to default? This cannot be undone.</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_pls_select_group">Please select or create a web group first!</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_group_name">Please enter a group name</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_title">Please enter a title</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_url">Please enter a URL</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_title">Confirm</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_delete_title">Confirm Delete</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_reset_title">Confirm Reset</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_tip_title">Notice</system:String>

    <!-- Search results -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_title">Open all webpages: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_subtitle">Open simultaneously in browser: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_search_in_title">Search in {0}: {1}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_title">[{0}] Please enter search keywords...</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_subtitle">Webpages in group: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_prefix">[Private] </system:String>

</ResourceDictionary>
