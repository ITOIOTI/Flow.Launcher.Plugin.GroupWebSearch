<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Plugin basic info -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_name">웹페이지 열기</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_description">Flow Launcher에서 웹페이지 및 사용자 지정 검색 그룹 열기</system:String>

    <!-- Main settings panel -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_groups">웹 그룹</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engines">웹 디렉터리</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete">삭제</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_edit">편집</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_add">추가</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset">초기화</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_prefix">키워드: {0}</system:String>

    <!-- Web group settings window -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_setting_title">웹 그룹 설정</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_name">그룹 이름</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords">키워드</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_placeholder">* 전체 트리거, 키워드 사이 공백 입력</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all">모든 웹페이지 열기</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable_group">이 그룹 활성화</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_cancel">취소</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_save">저장</system:String>

    <!-- Web catalog settings window -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engine_setting_title">웹 디렉터리 설정</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_title">제목</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_url">URL</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_icon">아이콘</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_select_icon">아이콘 선택</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_mode">시크릿 모드</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable">활성화</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm">확인</system:String>

    <!-- Dialogs & Prompts -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_group_confirm">웹 그룹 [{0}] 및 포함된 모든 항목을 삭제하시겠습니까?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_engine_confirm">[{0}] 항목을 삭제하시겠습니까?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset_confirm">모든 웹 그룹과 웹 디렉터리를 기본값으로 초기화하시겠습니까? 이 작업은 취소할 수 없습니다.</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_pls_select_group">먼저 웹 그룹을 선택하거나 새로 만드세요!</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_group_name">그룹 이름을 입력하세요</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_title">제목을 입력하세요</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_url">URL을 입력하세요</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_title">확인</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_delete_title">삭제 확인</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_reset_title">초기화 확인</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_tip_title">알림</system:String>

    <!-- Search results -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_title">모든 웹페이지 열기: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_subtitle">브라우저에서 동시에 열기: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_search_in_title">{0}에서 검색: {1}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_title">[{0}] 검색 키워드를 입력하세요...</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_subtitle">그룹에 포함된 웹페이지: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_prefix">[시크릿 모드] </system:String>

</ResourceDictionary>
