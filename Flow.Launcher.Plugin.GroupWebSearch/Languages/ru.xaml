<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Plugin basic info -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_name">Открыть веб-страницы</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_plugin_description">Открытие веб-страниц и групп поиска из Flow Launcher</system:String>

    <!-- Main settings panel -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_groups">Веб-группы</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engines">Веб-каталоги</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete">Удалить</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_edit">Изменить</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_add">Добавить</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset">Сброс</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_prefix">Ключевые слова: {0}</system:String>

    <!-- Web group settings window -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_setting_title">Настройки веб-группы</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_group_name">Имя группы</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords">Ключевые слова</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_keywords_placeholder">* Глобальный триггер, разделяйте пробелами</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all">Открыть все веб-страницы</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable_group">Включить эту группу</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_cancel">Отмена</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_save">Сохранить</system:String>

    <!-- Web catalog settings window -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_engine_setting_title">Настройки веб-каталога</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_title">Заголовок</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_url">URL</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_icon">Значок</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_select_icon">Выбрать значок</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_mode">Режим инкогнито</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_enable">Включить</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm">Подтвердить</system:String>

    <!-- Dialogs & Prompts -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_group_confirm">Вы уверены, что хотите удалить веб-группу [{0}] и всё её содержимое?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_delete_engine_confirm">Вы уверены, что хотите удалить [{0}]?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_reset_confirm">Вы действительно хотите сбросить все веб-группы и веб-каталоги к начальным значениям по умолчанию?</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_pls_select_group">Пожалуйста, сначала выберите или создайте веб-группу!</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_group_name">Пожалуйста, введите имя группы</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_title">Пожалуйста, введите заголовок</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_input_url">Пожалуйста, введите URL</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_title">Подтверждение</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_delete_title">Подтверждение удаления</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_confirm_reset_title">Подтверждение сброса</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_tip_title">Подсказка</system:String>

    <!-- Search results -->
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_title">Открыть все веб-страницы: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_open_all_subtitle">Одновременно открыть в браузере: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_search_in_title">Искать в {0}: {1}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_title">[{0}] Введите поисковый запрос...</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_empty_query_subtitle">Веб-страницы в группе: {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_groupwebsearch_private_prefix">[Инкогнито] </system:String>

</ResourceDictionary>
